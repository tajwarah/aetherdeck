# Copy to .env. Every key is optional — AetherDeck runs on keyless public sources
# (Wikipedia, arXiv, OpenStreetMap, GDELT) and labels anything that is sample data.

# --- Open-web search (set at least one for results from across the web) -----------------
# Without one, AetherDeck searches open sources only: Hacker News, Stack Overflow, OpenAlex, arXiv, news, Wikipedia.
# Brave Search API — an independent index of the whole web, with forums and news. https://brave.com/search/api/
BRAVE_API_KEY=
# Tavily — web search for research, with readable extracts (1,000 free searches a month). https://app.tavily.com/
TAVILY_API_KEY=
# SearXNG — a metasearch engine you host yourself; enable its JSON format. e.g. https://searx.example.org
SEARXNG_URL=

# YouTube Data API v3 — lets "play …" search videos for the floating player (free: 10,000 units/day ≈ 100 searches).
# Create at https://console.cloud.google.com → APIs & Services → YouTube Data API v3 → Credentials. Optional:
# without it, "play …" offers YouTube's own search page, and pasted video links still play.
YOUTUBE_API_KEY=

# --- AI layer (optional) ---------------------------------------------------------
# Set ONE key. AetherDeck picks the first it finds, in this order, or force one with LLM_PROVIDER.
# Without any key it uses a built-in planner and shows verbatim excerpts instead of AI summaries.
#
# Free options (sign up yourself; limits change, check each console):
#   OpenRouter  https://openrouter.ai/keys          free models end in ":free" (Kimi is preferred when one is offered)
#   Groq        https://console.groq.com/keys       free tier, OpenAI-compatible
#   Gemini      https://aistudio.google.com/apikey  free tier; free-tier data may be used to improve Google products
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
# Kimi direct from Moonshot (may need a small top-up):
MOONSHOT_API_KEY=
# Paid, billed per use by the provider (an API key is separate from a ChatGPT or Claude subscription):
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Any other OpenAI-compatible endpoint: LLM_PROVIDER=custom plus these two.
LLM_BASE_URL=
LLM_API_KEY=
# Optional overrides: provider (anthropic|openai|openrouter|groq|gemini|moonshot|custom|none) and model id.
# In the desktop app, Settings → AI model sets both (and lists the models your key can use).
# Leave LLM_MODEL empty to auto-pick (OpenRouter: best free model live; Moonshot: newest Kimi K2).
LLM_PROVIDER=
LLM_MODEL=

# Contact string sent in the User-Agent to OpenStreetMap / Wikipedia (their usage policies require one).
AETHERDECK_CONTACT=

# Force sample data even when live providers are reachable (useful offline or in demos).
AETHERDECK_DEMO=0

AETHERDECK_API_PORT=8787

# Sync across devices and shared groups. Links use this computer's Wi-Fi address unless PUBLIC_URL is set
# (set it to AetherDeck's public address once it is hosted, so phones anywhere can open the links).
PUBLIC_URL=
# AETHERDECK_DATA_DIR=./data/sync
